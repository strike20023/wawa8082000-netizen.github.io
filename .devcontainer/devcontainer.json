{
  "name": "NocoDB Git Workspace",
  "containerEnv": {
    "PUBLISH_SITE_URL": "https://strike20023.github.io/wawa8082000-netizen.github.io",
    "PUBLISH_HOST": "0.0.0.0",
    "MAX_FILE_BYTES": "99614720"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "NocoDB",
      "onAutoForward": "openBrowser"
    },
    "8787": {
      "label": "Publisher (internal)",
      "onAutoForward": "ignore"
    }
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
